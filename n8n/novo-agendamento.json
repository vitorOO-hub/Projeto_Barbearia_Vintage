        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "data_formatada",
              "name": "data_formatada",
              "type": "string",
              "value": "={{ $json.body.appointment_date ? DateTime.fromISO($json.body.appointment_date).setLocale('pt-BR').toFormat('dd/MM/yyyy') : 'a confirmar' }}"
            },
            {
              "id": "dia_semana",
              "name": "dia_semana",
              "type": "string",
              "value": "={{ $json.body.appointment_date ? DateTime.fromISO($json.body.appointment_date).setLocale('pt-BR').toFormat('cccc') : '' }}"
            },
            {
              "id": "hora_formatada",
              "name": "hora_formatada",
              "type": "string",
              "value": "={{ $json.body.appointment_time ? $json.body.appointment_time.substring(0, 5) : 'a confirmar' }}"
            },
            {
              "id": "status_pt",
              "name": "status_pt",
              "type": "string",
              "value": "={{ ({ agendado: 'Agendado', concluido: 'Concluído', cancelado: 'Cancelado', nao_compareceu: 'Não compareceu' })[$json.body.status] || $json.body.status }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "06c90e24-762d-4686-82be-5c5367ba9090",
